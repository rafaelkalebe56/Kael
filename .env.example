# Nunca publique este arquivo preenchido.
DISCORD_TOKEN=

# Opcional: acelera a atualização do comando /status no seu servidor de testes.
KAEL_DEV_GUILD_ID=

# Opcional: local dos dados persistentes. Na Railway, deixe vazio: o bot usa
# automaticamente o Volume montado em /data.
KAEL_DATA_DIR=

# Necessário apenas para o painel listar os servidores em que o Kael está.
# Use uma senha longa e igual à variável BOT_API_KEY do PainelKael.
DASHBOARD_API_KEY=
DASHBOARD_API_PORT=8080
